{
  "expo": {
    "name": "Acaindo_Delivery",
    "slug": "Acaindo_Delivery",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/produtos/logo-acaindo.png",
    "scheme": "acaindodelivery",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4B1D6B",
        "foregroundImage": "./assets/images/produtos/logo-acaindo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/produtos/logo-acaindo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#4B1D6B",
          "image": "./assets/images/produtos/logo-acaindo.png",
          "imageWidth": 96
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}